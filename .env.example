# ==============================================================================
# REVIEWFORGE ENVIRONMENT CONFIGURATION REFERENCE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # Options: development, staging, production
PORT=8000                              # Application server port
LOG_LEVEL=INFO                         # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000,https://review-forge.vercel.app # Comma-separated CORS origins

# ------------------------------------------------------------------------------
# 2. LLM API KEYS (At least one required for AI pair programming)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Hybrid PostgreSQL vs SQLite)
# ------------------------------------------------------------------------------
# If DATABASE_URL is set, ReviewForge connects to PostgreSQL (Cloud/Container).
# If DATABASE_URL is omitted, ReviewForge falls back to local SQLite (./data/local.db).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reviewforgedb
DB_POOL_SIZE=10                        # Connection pool size for PostgreSQL
DB_MAX_OVERFLOW=20                     # Maximum overflow connections for PostgreSQL

# ------------------------------------------------------------------------------
# 4. VECTOR DATABASE CONFIGURATION (Hybrid Pinecone vs ChromaDB)
# ------------------------------------------------------------------------------
# If PINECONE_API_KEY is set, Pinecone Cloud Vector Store is used.
# If omitted, local ChromaDB is used with lazy-loaded embeddings.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=reviewforge-index

# ------------------------------------------------------------------------------
# 5. REDIS CACHING & RATE LIMITING
# ------------------------------------------------------------------------------
# If REDIS_URL is set, Upstash or containerized Redis is used for caching.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 6. SENTRY ERROR TRACKING & MONITORING
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id

# ------------------------------------------------------------------------------
# 7. FRONTEND API ROUTING
# ------------------------------------------------------------------------------
API_URL=http://localhost:8000          # Backend URL for frontend to communicate with
